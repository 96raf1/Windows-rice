/* yasb-colors.css - Dynamically Generated by Matugen */

:root {
    /* Primary Colors */
    --background: {{colors.surface.default.hex}};
    --background2: {{colors.surface_container.default.hex}};
    --accent: {{colors.primary.default.hex}};
    --text: {{colors.on_surface.default.hex}};
    --accentText: {{colors.on_primary.default.hex}};
    --hover: {{colors.surface_container_highest.default.hex}};
    --mutedBG: {{colors.surface_container_low.default.hex}};
    --border: {{colors.outline_variant.default.hex}};
    --redFlash: {{colors.error.default.hex}};
    --subtext: {{colors.on_surface_variant.default.hex}}; 

    /* Catppuccin Mocha Core - Mapped for structural integrity */
    --ctp-mocha-base: {{colors.surface.default.hex}};
    --ctp-mocha-surface: {{colors.surface_container.default.hex}};
    --ctp-mocha-overlay: {{colors.outline.default.hex}};
    --ctp-mocha-text: {{colors.on_surface.default.hex}};
    --ctp-mocha-primary: {{colors.primary.default.hex}};
    --ctp-mocha-crust: {{colors.surface_container_lowest.default.hex}};

    /* Base / Utility Colors */
    --black: #000000;
    --white: #ffffff;
    --white-10: {{colors.on_surface.default.hex_alpha | set_alpha: 0.1}};
    --white-20: {{colors.on_surface.default.hex_alpha | set_alpha: 0.2}};
    --white-40: {{colors.on_surface.default.hex_alpha | set_alpha: 0.4}};
    --white-60: {{colors.on_surface.default.hex_alpha | set_alpha: 0.6}};
    --transparent-white: rgba(255, 255, 255, 0);
    --transparent-black: rgba(0, 0, 0, 0);
    --grey-50: {{colors.on_surface.default.hex_alpha | set_alpha: 0.5}};
    --disabled-text: {{colors.on_surface.default.hex_alpha | set_alpha: 0.5}};

    /* Palette Accents */
    --blue: {{colors.primary.default.hex}};
    --blue-light: {{colors.primary_container.default.hex}};
    --sky: {{colors.tertiary.default.hex}};
    --flamingo: {{colors.secondary.default.hex}};
    --red: {{colors.error.default.hex}};
    --red-light: {{colors.error_container.default.hex}};
    --orange: {{colors.secondary.default.hex}};
    --orange-light: {{colors.secondary_container.default.hex}};
    --yellow: {{colors.tertiary.default.hex}};
    --green-light: {{colors.primary_container.default.hex}};
    --green: {{colors.primary.default.hex}};
    --cyan: {{colors.tertiary.default.hex}};
    --cyan-light: {{colors.tertiary_container.default.hex}};
    --lime: {{colors.secondary_container.default.hex}};

    /* Component-Specific Colors */
    --ws-offline-text: {{colors.on_surface.default.hex}};
    --tiling-btn-text: {{colors.on_primary.default.hex}};
    --uptime-text: {{colors.on_surface_variant.default.hex_alpha | set_alpha: 0.726}};
    --power-btn-bg: {{colors.surface_container.default.hex_alpha | set_alpha: 0.75}};
    --power-btn-hover-bg: {{colors.surface_container_highest.default.hex}};
    --power-btn-icon: {{colors.on_surface.default.hex_alpha | set_alpha: 0.25}};
    --power-btn-cancel-icon: {{colors.error.default.hex_alpha | set_alpha: 0.55}};
    --power-btn-cancel-label: {{colors.error.default.hex_alpha | set_alpha: 0.95}};
    --batt-label: {{colors.on_surface.default.hex}};
    --notes-menu-bg: {{colors.surface_container_lowest.default.hex_alpha | set_alpha: 0.8}};
    --notes-btn-text: {{colors.on_surface_variant.default.hex}};
    --notes-copy-btn: {{colors.primary_container.default.hex}};
    --notes-input-bg: {{colors.surface_variant.default.hex_alpha | set_alpha: 0.2}};
    --notes-input-focus: {{colors.primary.default.hex}};
}
