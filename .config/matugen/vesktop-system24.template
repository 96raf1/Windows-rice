/* import theme modules */
@import url("https://snajperexe.github.io/TokyoMidnight/addons/memberlist.css");
@import url('https://refact0r.github.io/system24/build/system24.css');

body {
    /* font, change to '' for default discord font */
    --font: 'DM Mono'; /* change to '' for default discord font */
    --code-font: 'DM Mono'; /* change to '' for default discord font */
    font-weight: 300; /* text font weight. 300 is light, 400 is normal. DOES NOT AFFECT BOLD TEXT */
    letter-spacing: -0.05ch; /* decreases letter spacing for better readability. recommended on monospace fonts.*/

    /* sizes */
    --gap: 12px; /* spacing between panels */
    --divider-thickness: 4px; /* thickness of unread messages divider and highlighted message borders */
    --border-thickness: 2.5px; /* thickness of borders around main panels. DOES NOT AFFECT OTHER BORDERS */
    --border-hover-transition: 0.2s ease; /* transition for borders when hovered */

    /* animation/transition options */
    --animations: on; /* off: disable animations/transitions, on: enable animations/transitions */
    --list-item-transition: 0.2s ease; /* transition for list items */
    --dms-icon-svg-transition: 0.4s ease; /* transition for the dms icon */

    /* top bar options */
    --top-bar-height: var(--gap); /* height of the top bar (discord default is 36px, old discord style is 24px, var(--gap) recommended if button position is set to titlebar) */
    --top-bar-button-position: titlebar; /* off: default position, hide: hide buttons completely, serverlist: move inbox button to server list, titlebar: move inbox button to channel titlebar (will hide title) */
    --top-bar-title-position: off; /* off: default centered position, hide: hide title completely, left: left align title (like old discord) */
    --subtle-top-bar-title: off; /* off: default, on: hide the icon and use subtle text color (like old discord) */

    /* window controls */
    --custom-window-controls: on; /* off: default window controls, on: custom window controls */
    --window-control-size: 14px; /* size of custom window controls */

    /* dms button options */
    --custom-dms-icon: custom; /* off: use default discord icon, hide: remove icon entirely, custom: use custom icon */
    --spider: url('data:image/png;base64,');
    --skull: url('data:image/png;base64,');
    --dms-icon-svg-url: url("https://refact0r.github.io/midnight-discord/assets/Font_Awesome_5_solid_moon.svg");
    --dms-icon-svg-size: 90%; /* icon svg url. MUST BE A SVG. */
    --dms-icon-svg-size: 90%; /* size of the svg (css mask-size property) */
    --dms-icon-color-before: var(--icon-subtle); /* normal icon color */
    --dms-icon-color-after: var(--white); /* icon color when button is hovered/selected */
    --custom-dms-background: off; /* off to disable, image to use a background image (must set url variable below), color to use a custom color/gradient */
    --dms-background-image-url: url(''); /* url of the background image */
    --dms-background-image-size: cover; /* size of the background image (css background-size property) */
    --dms-background-color: linear-gradient(70deg, var(--blue-2), var(--purple-2), var(--red-2)); /* fixed color/gradient (css background property) */

    /* background image options */
    --background-image: off; /* off: no background image, on: enable background image (must set url variable below) */
    --background-image-url: url(''); /* url of the background image */

    /* transparency/blur options */
    /* NOTE: TO USE TRANSPARENCY/BLUR, YOU MUST HAVE TRANSPARENT BG COLORS. FOR EXAMPLE: --bg-4: hsla(220, 15%, 10%, 0.7); */
    --transparency-tweaks: off; /* off: no changes, on: remove some elements for better transparency */
    --remove-bg-layer: off; /* off: no changes, on: remove the base --bg-3 layer for use with window transparency (WILL OVERRIDE BACKGROUND IMAGE) */
    --panel-blur: off; /* off: no changes, on: blur the background of panels */
    --blur-amount: 12px; /* amount of blur */
    --bg-floating: var(--bg-3); /* set this to a more opaque color if floating panels look too transparent. only applies if panel blur is on  */

    /* other options */
    --small-user-panel: on; /* off: default user panel, on: smaller user panel like in old discord */

    /* unrounding options */
    --unrounding: on; /* off: default, on: remove rounded corners from panels */

    /* styling options */
    --custom-spotify-bar: on; /* off: default, on: custom text-like spotify progress bar */
    --ascii-titles: on; /* off: default, on: use ascii font for titles at the start of a channel */
    --ascii-loader: system24; /* off: default, system24: use system24 ascii loader, cats: use cats loader */

    /* panel labels */
    --panel-labels: on; /* off: default, on: add labels to panels */
    --label-color: var(--text-muted); /* color of labels */
    --label-font-weight: 500; /* font weight of labels */
}

/* color options */
:root {
    --colors: on; /* off: discord default colors, on: midnight custom colors */

    /* text colors */
    --text-0: {{colors.surface.default.hex}};               /* text on colored elements */
    --text-1: {{colors.on_surface.default.hex}};            /* other normally white text */
    --text-2: {{colors.on_surface.default.hex}};            /* headings and important text */
    --text-3: {{colors.on_surface_variant.default.hex}};    /* normal text */
    --text-4: {{colors.on_surface_variant.default.hex}};    /* icon buttons and channels */
    --text-5: {{colors.outline.default.hex}};               /* muted channels/chats and timestamps */

    /* background and dark colors */
    --bg-1: {{colors.surface_variant.default.hex}};                     /* dark buttons when clicked */
    --bg-2: {{colors.surface_container_high.default.hex}};              /* dark buttons */
    --bg-3: {{colors.surface_container_low.default.hex}};               /* spacing, secondary elements */
    --bg-4: {{colors.surface.default.hex}};                             /* main background color */
    --hover: {{colors.surface_bright.default.hex}};                     /* channels and buttons when hovered */
    --active: {{colors.surface_bright.default.hex}};                    /* channels and buttons when clicked or selected */
    --message-hover: {{colors.surface_bright.default.hex}};             /* messages when hovered */

    /* accent colors */
    --accent-1: {{colors.tertiary.default.hex}};            /* links */
    --accent-2: {{colors.primary.default.hex}};             /* general unread/mention elements, some icons when active */
    --accent-3: {{colors.primary.default.hex}};             /* accent buttons */
    --accent-4: {{colors.surface_bright.default.hex}};      /* accent buttons when hovered */
    --accent-5: {{colors.primary_fixed_dim.default.hex}};   /* accent buttons when clicked */
    --accent-new: {{colors.inverse_primary.default.hex}};   /* user panel mute & deafen buttons */
    --mention:  {{colors.surface.default.hex}};             /* mentions & mention messages */
    --mention-hover: {{colors.surface_bright.default.hex}}; /* mentions & mention messages when hovered */
    --reply: linear-gradient(to right, color-mix(in hsl, var(--text-3), transparent 90%) 40%, transparent); /* background of messages that reply to you */
    --reply-hover: linear-gradient(to right, color-mix(in hsl, var(--text-3), transparent 95%) 40%, transparent); /* background of messages that reply to you when hovered */

    /* color of status indicators and window controls */
    --online-indicator: {{colors.inverse_primary.default.hex}};     /* change to #23a55a for default green */
    --dnd-indicator: {{colors.error.default.hex}};                  /* change to #f13f43 for default red */
    --idle-indicator: {{colors.tertiary_container.default.hex}};    /* change to #f0b232 for default yellow */
    --streaming-indicator: {{colors.on_primary.default.hex}};       /* change to #593695 for default purple */
    --offline: var(--text-4); /* change to #82838b for default offline color */

    /* border colors */
    --border-light: var(--hover); /* general light border color */
    --border: var(--active); /* general normal border color */
    --border-hover: var(--accent-2); /* border color of panels when hovered */
    --button-border: hsl(220, 0%, 100%, 0.1); /* neutral border color of buttons */

    /* base colors */
    --red-1: oklch(75% 0.13 0);
    --red-2: oklch(70% 0.13 0);
    --red-3: oklch(65% 0.13 0);
    --red-4: oklch(60% 0.13 0);
    --red-5: oklch(55% 0.13 0);

    --green-1: oklch(75% 0.12 170);
    --green-2: oklch(70% 0.12 170);
    --green-3: oklch(65% 0.12 170);
    --green-4: oklch(60% 0.12 170);
    --green-5: oklch(55% 0.12 160);

    --blue-1: oklch(75% 0.11 215);
    --blue-2: oklch(70% 0.11 215);
    --blue-3: oklch(65% 0.11 215);
    --blue-4: oklch(60% 0.11 215);
    --blue-5: oklch(55% 0.11 215);

    --yellow-1: oklch(80% 0.12 90);
    --yellow-2: oklch(75% 0.12 90);
    --yellow-3: oklch(70% 0.12 90);
    --yellow-4: oklch(65% 0.12 90);
    --yellow-5: oklch(60% 0.12 90);

    --purple-1: oklch(75% 0.12 310);
    --purple-2: oklch(70% 0.12 310);
    --purple-3: oklch(65% 0.12 310);
    --purple-4: oklch(60% 0.12 310);
    --purple-5: oklch(55% 0.12 310);
}

/* =====================================================
   DISCORD NATIVE SEMANTIC VARIABLES
   Dynamic wallpaper-driven Arcana mapping
   ===================================================== */

:root {

/*
 * SURFACES
 * Deep transparent layers built from the wallpaper's
 * generated surface colors.
 */

--background-primary:
    color-mix(in srgb, {{colors.surface.default.hex}} 34%, transparent) !important;

--background-secondary:
    color-mix(in srgb, {{colors.surface.default.hex}} 46%, transparent) !important;

--background-secondary-alt:
    color-mix(in srgb, {{colors.surface_container.default.hex}} 40%, transparent) !important;

--background-tertiary:
    color-mix(in srgb, {{colors.surface.default.hex}} 56%, transparent) !important;

/*
 * BASE LAYERS
 */

--background-base-low:
    color-mix(in srgb, {{colors.surface.default.hex}} 30%, transparent) !important;

--background-base-lower:
    color-mix(in srgb, {{colors.surface.default.hex}} 38%, transparent) !important;

--background-base-lowest:
    color-mix(in srgb, {{colors.surface.default.hex}} 50%, transparent) !important;

/*
 * RAISED SURFACES
 * A small amount of secondary color gives the glass
 * its atmospheric tint.
 */

--background-surface-high:
    color-mix(in srgb, {{colors.secondary.default.hex}} 4.5%, transparent) !important;

--background-surface-higher:
    color-mix(in srgb, {{colors.secondary.default.hex}} 7%, transparent) !important;

--background-surface-highest:
    color-mix(in srgb, {{colors.on_surface_variant.default.hex}} 9.5%, transparent) !important;

/*
 * SYSTEM24 BASE SURFACES
 */

--bg-base-primary:
    color-mix(in srgb, {{colors.surface.default.hex}} 32%, transparent) !important;

--bg-base-secondary:
    color-mix(in srgb, {{colors.surface.default.hex}} 42%, transparent) !important;

--bg-base-tertiary:
    color-mix(in srgb, {{colors.surface_container.default.hex}} 42%, transparent) !important;

/*
 * OVERLAYS / RAISED PANELS
 */

--bg-surface-overlay:
    color-mix(in srgb, {{colors.surface.default.hex}} 80%, transparent) !important;

--bg-surface-raised:
    color-mix(in srgb, {{colors.primary_container.default.hex}} 68%, transparent) !important;

--background-floating:
    color-mix(in srgb, {{colors.surface.default.hex}} 84%, transparent) !important;

--background-nested-floating:
    color-mix(in srgb, {{colors.surface.default.hex}} 78%, transparent) !important;

/*
 * CHAT / INPUT / MODALS
 */

--chat-background-default:
    color-mix(in srgb, {{colors.surface.default.hex}} 26%, transparent) !important;

--input-background:
    color-mix(in srgb, {{colors.surface.default.hex}} 64%, transparent) !important;

--modal-background:
    color-mix(in srgb, {{colors.surface.default.hex}} 80%, transparent) !important;

--modal-footer-background:
    color-mix(in srgb, {{colors.surface.default.hex}} 82%, transparent) !important;

/*
 * INTERACTION
 *
 * Primary = luminous accent
 * Primary container = deeper accent
 */

--background-accent:
    color-mix(in srgb, {{colors.primary_container.default.hex}} 30%, transparent) !important;

--background-modifier-hover:
    color-mix(in srgb, {{colors.primary.default.hex}} 7.5%, transparent) !important;

--background-modifier-active:
    color-mix(in srgb, {{colors.primary_container.default.hex}} 34%, transparent) !important;

--background-modifier-selected:
    color-mix(in srgb, {{colors.primary_container.default.hex}} 46%, transparent) !important;

--background-modifier-accent:
    color-mix(in srgb, {{colors.secondary.default.hex}} 7.5%, transparent) !important;

/*
 * SUBTLE MODIFIERS
 */

--bg-mod-faint:
    color-mix(in srgb, {{colors.secondary.default.hex}} 3.5%, transparent) !important;

--bg-mod-subtle:
    color-mix(in srgb, {{colors.secondary.default.hex}} 6.5%, transparent) !important;

--bg-mod-strong:
    color-mix(in srgb, {{colors.primary_container.default.hex}} 34%, transparent) !important;

/*
 * BORDERS
 *
 * Outline provides the neutral glass edge.
 * Primary provides the luminous focused edge.
 */

--border-faint:
    color-mix(in srgb, {{colors.outline.default.hex}} 5%, transparent) !important;

--border-subtle:
    color-mix(in srgb, {{colors.outline.default.hex}} 8%, transparent) !important;

--border-normal:
    color-mix(in srgb, {{colors.secondary.default.hex}} 12%, transparent) !important;

--border-strong:
    color-mix(in srgb, {{colors.primary.default.hex}} 24%, transparent) !important;

--input-border:
    color-mix(in srgb, {{colors.outline.default.hex}} 12%, transparent) !important;

/*
 * INTERACTIVE TEXT / ICONS
 */

--interactive-normal: {{colors.on_surface_variant.default.hex}} !important;
--interactive-hover: {{colors.on_surface.default.hex}} !important;
--interactive-active: {{colors.on_primary.default.hex}} !important;
--interactive-muted: {{colors.outline.default.hex}} !important;

--channels-default: {{colors.on_surface_variant.default.hex}} !important;
--channel-icon: {{colors.outline.default.hex}} !important;
--channel-text-area-placeholder: {{colors.outline.default.hex}} !important;

/*
 * MENTIONS
 */

--mention-foreground: {{colors.on_primary.default.hex}} !important;

--mention-background:
    color-mix(in srgb, {{colors.primary.default.hex}} 12%, transparent) !important;

/*
 * BRAND / BLURPLE
 *
 * Discord's blue/purple branding is redirected into
 * the wallpaper's generated primary color family.
 */

--brand-260: {{colors.on_primary_container.default.hex}} !important;
--brand-360: {{colors.secondary.default.hex}} !important;
--brand-500: {{colors.primary.default.hex}} !important;
--brand-560: {{colors.primary_container.default.hex}} !important;
--brand-600: {{colors.primary_container.default.hex}} !important;

--blurple-50: {{colors.primary.default.hex}} !important;
--bg-brand: {{colors.primary_container.default.hex}} !important;

/*
 * STATUS
 *
 * Keep semantic meaning here rather than forcing
 * everything into the accent color.
 */

--status-positive: {{colors.secondary.default.hex}} !important;
--status-warning: {{colors.tertiary.default.hex}} !important;
--status-danger: {{colors.error.default.hex}} !important;
--status-speaking: {{colors.primary.default.hex}} !important;

/*
 * SCROLLBARS
 */

--scrollbar-auto-thumb: {{colors.primary_container.default.hex}} !important;
--scrollbar-auto-track: transparent !important;

--scrollbar-thin-thumb: {{colors.primary_container.default.hex}} !important;
--scrollbar-thin-track: transparent !important;

}

/* =========================================================
   WINDOW / APP TRANSPARENCY
   ========================================================= */

html,
body,
#app-mount {
    background: transparent !important;
}

/* =========================================================
   MAIN SURFACES
   ========================================================= */

[class*="sidebar"],
[class*="chat"],
[class*="membersWrap"],
[class*="panels"],
[class*="content"],
[class*="container"] {
    border-color: rgba(137,209,223,0.08) !important;
}


/* =========================================================
   FLOATING GLASS
   ========================================================= */

[class*="menu"],
[class*="popout"],
[class*="tooltip"],
[class*="picker"],
[role="menu"] {
    background-color: rgba(8,12,21,0.82) !important;
    backdrop-filter: blur(20px) saturate(118%) !important;
    -webkit-backdrop-filter: blur(20px) saturate(118%) !important;

    border-color: rgba(137,209,223,0.12) !important;
    box-shadow:
        0 8px 28px rgba(0,0,0,0.34), 0 0 24px rgba(13,209,229,0.035) !important;
}

/*
 * Dialogs stay translucent through the semantic Discord variables,
 * but do NOT receive backdrop-filter here. This avoids creating
 * unwanted containing/stacking contexts for fullscreen media controls.
 */
[role="dialog"],
[class*="modal"] {
    border-color: rgba(137,209,223,0.12) !important;
}

/* =========================================================
   DISCORD MEDIA / IMAGE PREVIEW FIX
   Keep fullscreen carousel completely out of the generic glass layer.
   ========================================================= */

[class*="carouselModal"],
[role="dialog"][class*="carouselModal"],
[role="dialog"]:has([class*="carouselModal"]) {
    background: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    box-shadow: none !important;
}

/* Do not let descendants of the media viewer inherit accidental blur. */
[class*="carouselModal"] [class*="modal"],
[class*="carouselModal"] [role="dialog"] {
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
}

/* =========================================================
   INPUTS
   ========================================================= */

input,
textarea {
    background-color: rgba(8,12,21,0.64) !important;
    color: #F4FBFF !important;
    border-color: rgba(137,209,223,0.12) !important;
}


/* =========================================================
   BUTTONS / SELECTED STATES
   ========================================================= */

button:hover,
[role="button"]:hover {
    background-color: rgba(13,209,229,0.075) !important;
}

[aria-selected="true"],
[class*="selected"] {
    background-color: rgba(25,82,129,0.46) !important;
}

/* =========================================================
   SCROLLBARS
   ========================================================= */

::-webkit-scrollbar-thumb {
    background-color: #195281 !important;
}

::-webkit-scrollbar-thumb:hover {
    background-color: #4CC0D8 !important;
}

::-webkit-scrollbar-track {
    background-color: transparent !important;
}

/* =========================================================
   ARCANA TRADITIONAL — FINAL ASTRAL POLISH
   ========================================================= */

/* Thin cyan focus ring rather than Discord blurple */
:focus-visible {
    outline-color: rgba(13, 209, 229, 0.72) !important;
}

/* Selected navigation / channels: YASB-like sapphire glass */
[aria-selected="true"],
[class*="selected"] {
    box-shadow:
        inset 2px 0 0 rgba(13, 209, 229, 0.72),
        inset 0 0 0 1px rgba(137, 209, 223, 0.055) !important;
}

/* Unread / notification emphasis */
[class*="unread"],
[class*="newMessages"] {
    color: #0DD1E5 !important;
}

/* Chat input gets the same deep-glass treatment as YASB cards */
[class*="channelTextArea"],
[class*="scrollableContainer"] {
    border-color: rgba(137, 209, 223, 0.10) !important;
    box-shadow:
        inset 0 1px 0 rgba(244, 251, 255, 0.025),
        0 0 18px rgba(13, 209, 229, 0.018) !important;
}

/* Floating surfaces: faint astral edge, no giant cyan panels */
[role="menu"],
[class*="popout"],
[class*="picker"],
[class*="tooltip"] {
    box-shadow:
        0 10px 32px rgba(0,0,0,0.36),
        0 0 0 1px rgba(76,192,216,0.08),
        0 0 26px rgba(13,209,229,0.025) !important;
}
